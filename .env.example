# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (local values: `pnpm db:start` prints them) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: bypasses row level security, used for payments and webhooks
SUPABASE_SECRET_KEY=

# --- Stripe (test mode only: the app refuses to start with an sk_live_ key) ---
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally, or the Dashboard endpoint in production
STRIPE_WEBHOOK_SECRET=

# --- Marketplace rules ---
# Platform commission in basis points (1500 = 15%)
PLATFORM_FEE_BPS=1500

# --- Jobs ---
# Shared secret for /api/cron/tick (expire holds, complete lessons, pay tutors)
CRON_SECRET=change-me

# --- Demo accounts (public, test mode) ---
DEMO_PASSWORD=demo-password-123
